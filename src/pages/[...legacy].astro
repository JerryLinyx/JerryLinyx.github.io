---
import Base from "../layouts/Base.astro";
import { legacy, oldRoutes, prepareHtml } from "../lib/content.mjs";
import redirects from "../../scripts/legacy-redirects.json";
import "katex/dist/katex.min.css";
export function getStaticPaths() {
  const snapshots = [...legacy.articles, ...legacy.extras].map((a) => ({
    params: { legacy: a.archive.replace(/^\//, "").replace(/\/$/, "") },
    props: { snapshot: a },
  }));
  snapshots.push({
    params: { legacy: "archive/cv" },
    props: {
      snapshot: {
        title: "个人简历 / 2025",
        html: legacy.cv.html,
        date: "2025",
        archive: "/archive/cv/",
      },
    },
  });
  const routes = new Map(oldRoutes);
  for (const r of redirects) {
    const to = oldRoutes.get(r.to) || r.to;
    if (!routes.has(r.from)) routes.set(r.from, to);
  }
  for (const from of [
    "/blog/archive/",
    "/blog/tags/",
    "/plog/archive/",
    "/plog/tags/",
    "/docs/",
  ])
    routes.set(from, "/writing/");
  const reserved = new Set([
    "/",
    "/archive/",
    "/work/",
    "/research/",
    "/writing/",
    "/life/",
    "/about/",
    ...snapshots.map((s) => "/" + s.params.legacy + "/"),
  ]);
  return [
    ...snapshots,
    ...[...routes]
      .filter(
        ([from]) => !/^\/(Doc|CV)(\/|$)/.test(from) && !reserved.has(from),
      )
      .map(([from, to]) => ({
        params: { legacy: from.replace(/^\//, "").replace(/\/$/, "") },
        props: { to },
      })),
  ];
}
const { snapshot, to } = Astro.props;
const html = snapshot ? prepareHtml(snapshot.html).html : "";
---

{to ? (
  <html lang="zh-CN">
    <head>
      <meta charset="utf-8" />
      <meta name="viewport" content="width=device-width, initial-scale=1" />
      <title>内容已移到新位置 · 林煜轩</title>
      <meta http-equiv="refresh" content={`0;url=${to}`} />
      <link
        rel="canonical"
        href={new URL(to, "https://jerrylinyx.github.io")}
      />
      <meta name="robots" content="noindex" />
    </head>
    <body>
      <p>
        这篇内容已移到新的位置。<a href={to}>继续阅读 →</a>
      </p>
    </body>
  </html>
) : (
  <Base title={`${snapshot.title} · 历史存档 · 林煜轩`}>
    <article class="reader wrap">
      <header class="reader-heading">
        <a class="back-link" href="/archive/">
          ← 旧日存档
        </a>
        <p class="eyebrow">
          HISTORICAL EDITION / {snapshot.date || "EARLY WEB"}
        </p>
        <h1>{snapshot.title}</h1>
        <p class="notice">
          这是历史版本，其中的信息和观点可能已经过时。
          <a href="/writing/">阅读现行文章</a> ·{" "}
          <a href="/about/">查看当前简介</a>
        </p>
      </header>
      <div class="prose archive-prose" set:html={html} />
    </article>
  </Base>
)}
