---
import Base from "../../layouts/Base.astro";
import { projects, moreProjects } from "../../data/portfolio.js";
const all = [...projects, ...moreProjects];
const images = {
  fingoat: "fingoat",
  pacc: "pacc",
  "probabilistic-imaging": "imaging",
  "cuda-lenet": "cuda",
  "linux-kernel": "os",
};
---

<Base title="作品 · 林煜轩" section="work">
  <section class="page-heading wrap">
    <p class="eyebrow">01 / SELECTED WORK / 2024—2026</p>
    <h1>
      一些想法，<span>有了具体的形状。</span>
    </h1>
    <div class="heading-bottom">
      <p>
        从 AI 应用到系统底层。
        <br />
        六个项目，记录问题、取舍与结果。
      </p>
      <span class="mono">ENGINEERING / RESEARCH / TOOLS</span>
    </div>
  </section>
  <section class="wrap project-grid" aria-label="全部作品">
    {all.map((p) => (
      <a href={`/work/${p.slug}/`} class="project-card">
        <div class="project-cover">
          <span class="mono">
            {p.number} / {p.category}
          </span>
          {images[p.slug] ? (
            <img
              src={`/media/${images[p.slug]}.webp`}
              alt={`${p.title} 的真实项目图示`}
              width="500"
              height="240"
              loading="lazy"
            />
          ) : (
            <div class="type-specimen" aria-hidden="true">
              text → shape
            </div>
          )}
          <span class="cover-bottom mono">
            {p.year}
            <b aria-hidden="true">↗</b>
          </span>
        </div>
        <div class="project-caption">
          <h2>{p.title}</h2>
          <p>{p.subtitle}</p>
          <div class="tags">
            {p.tags.slice(0, 3).map((t) => (
              <span>{t}</span>
            ))}
          </div>
        </div>
      </a>
    ))}
  </section>
</Base>
