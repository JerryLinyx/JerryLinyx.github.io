---
import Base from "../../layouts/Base.astro";
import { projects } from "../../data/portfolio.js";
import { oldRoutes, mediaSize } from "../../lib/content.mjs";
export function getStaticPaths() {
  return projects.map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}
const { project: p } = Astro.props;
const index = projects.findIndex((x) => x.slug === p.slug);
const next = projects[(index + 1) % projects.length];
const related =
  oldRoutes.get(p.related.endsWith("/") ? p.related : p.related + "/") ||
  "/writing/";
---

<Base
  title={`${p.title} · 作品 · 林煜轩`}
  description={p.description}
  section="work"
>
  <article class="case">
    <header class="wrap case-head">
      <a class="back" href="/work/">
        所有作品
      </a>
      <h1>{p.title}</h1>
      <p class="case-subtitle">{p.subtitle}</p>
      <dl class="case-meta">
        <div>
          <dt>方向</dt>
          <dd>{p.category}</dd>
        </div>
        <div>
          <dt>时间</dt>
          <dd>{p.year}</dd>
        </div>
        <div>
          <dt>技术</dt>
          <dd>{p.tags.join("、")}</dd>
        </div>
        <div>
          <dt>链接</dt>
          <dd class="case-links">
            <a href={p.repo}>源代码 ↗</a>
            {p.paper && <a href={p.paper}>论文 ↗</a>}
          </dd>
        </div>
      </dl>
    </header>
    {p.image && (
      <figure class="wrap case-figure">
        <div class="plate">
          <img
            src={`/media/${p.image}.webp`}
            alt={p.imageAlt}
            {...mediaSize(`/media/${p.image}.webp`)}
          />
        </div>
        <figcaption>{p.imageAlt}</figcaption>
      </figure>
    )}
    <div class="wrap case-body">
      <p class="case-summary">{p.description}</p>
      <section>
        <h2>问题</h2>
        <p>{p.context}</p>
      </section>
      <section>
        <h2>关键取舍</h2>
        <dl class="decisions">
          {p.decisions.map(([title, text]) => (
            <div>
              <dt>{title}</dt>
              <dd>{text}</dd>
            </div>
          ))}
        </dl>
      </section>
      <section>
        <h2>结果</h2>
        {p.metric && (
          <p class="metric">
            <strong>{p.metric}</strong>
            <span>{p.metricLabel}</span>
          </p>
        )}
        <p>{p.outcome}</p>
        <a class="inline-more" href={related}>
          相关笔记
        </a>
      </section>
    </div>
    <nav class="wrap next" aria-label="下一个项目">
      <span>下一个项目</span>
      <a href={`/work/${next.slug}/`}>
        <strong>{next.title}</strong>
        <span>{next.subtitle}</span>
      </a>
    </nav>
  </article>
</Base>
