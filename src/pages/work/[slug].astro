---
import Base from "../../layouts/Base.astro";
import { projects, moreProjects } from "../../data/portfolio.js";
import { oldRoutes } from "../../lib/content.mjs";
export function getStaticPaths() {
  return [...projects, ...moreProjects].map((p) => ({
    params: { slug: p.slug },
    props: { project: p },
  }));
}
const { project: p } = Astro.props;
const all = [...projects, ...moreProjects];
const next = all[(all.findIndex((x) => x.slug === p.slug) + 1) % all.length];
const image = {
  fingoat: "fingoat",
  pacc: "pacc",
  "probabilistic-imaging": "imaging",
  "cuda-lenet": "cuda",
  "linux-kernel": "os",
}[p.slug];
const related =
  oldRoutes.get(p.related.endsWith("/") ? p.related : p.related + "/") ||
  "/writing/";
---

<Base
  title={`${p.title} · 作品 · 林煜轩`}
  description={p.description}
  section="work"
>
  <article>
    <header class="case-heading wrap">
      <a class="back-link" href="/work/">
        ← 所有作品
      </a>
      <p class="eyebrow">
        {p.number} / {p.category} / {p.year}
      </p>
      <h1>{p.title}</h1>
      <p class="case-subtitle">{p.subtitle}</p>
      <div class="case-summary">
        <p>{p.description}</p>
        <div>
          <a class="button" href={p.repo}>
            查看源代码 <span aria-hidden="true">↗</span>
          </a>
          {p.paper && (
            <a class="text-link" href={p.paper}>
              阅读论文 ↗
            </a>
          )}
        </div>
      </div>
      <div class="tags">
        {p.tags.map((t) => (
          <span>{t}</span>
        ))}
      </div>
    </header>
    {image && (
      <figure class="case-image wrap">
        <img
          src={`/media/${image}.webp`}
          alt={p.imageAlt || `${p.title} 项目示意图`}
          loading="eager"
        />
        <figcaption class="mono">
          PROJECT MATERIAL / {p.title.toUpperCase()}
        </figcaption>
      </figure>
    )}
    <div class="case-body wrap">
      <aside class="case-meta">
        <p class="eyebrow">THE PROCESS</p>
        <a href="#context">01 问题与背景</a>
        <a href="#decisions">02 设计与实现</a>
        <a href="#outcome">03 结果与反思</a>
      </aside>
      <div class="case-prose">
        <section id="context">
          <p class="eyebrow">01 / CONTEXT</p>
          <h2>从什么问题出发？</h2>
          <p>{p.context}</p>
        </section>
        <section id="decisions">
          <p class="eyebrow">02 / DECISIONS</p>
          <h2>关键设计与取舍。</h2>
          {p.decisions.map(([title, text], i) => (
            <div class="decision">
              <span class="mono">0{i + 1}</span>
              <div>
                <h3>{title}</h3>
                <p>{text}</p>
              </div>
            </div>
          ))}
        </section>
        <section id="outcome">
          <p class="eyebrow">03 / REFLECTION</p>
          <h2>留下了什么。</h2>
          <p>{p.outcome}</p>
          <a class="text-link" href={related}>
            相关学习手记 <span aria-hidden="true">↗</span>
          </a>
        </section>
      </div>
    </div>
    <div class="next-project wrap">
      <span class="eyebrow">NEXT PROJECT</span>
      <a href={`/work/${next.slug}/`}>
        {next.title}
        <span aria-hidden="true">↗</span>
      </a>
    </div>
  </article>
</Base>
