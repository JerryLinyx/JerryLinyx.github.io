---
import Base from "../layouts/Base.astro";
import { mediaSize } from "../lib/content.mjs";
import { profile } from "../data/portfolio.js";
import {
  resumePdf,
  selfReview,
  education,
  experience,
  research,
  projects,
  activities,
} from "../data/resume.js";
---

<Base
  title="关于 · 林煜轩"
  description="林煜轩的教育、研究、工程经历与联系信息。"
  section="about"
>
  <header class="wrap about-head">
    <div class="about-intro">
      <h1>
        林煜轩 <span>Yuxuan Lin</span>
      </h1>
      <div class="lead about-review">
        {selfReview.map((t) => (
          <p>{t}</p>
        ))}
      </div>
      <p class="about-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href={profile.github}>GitHub ↗</a>
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <a href={resumePdf} download="林煜轩CV.pdf">
          下载简历 PDF
        </a>
      </p>
    </div>
    <figure class="portrait">
      <img
        src="/media/portrait.webp"
        alt="林煜轩站在红墙前"
        {...mediaSize("/media/portrait.webp")}
        fetchpriority="high"
      />
    </figure>
  </header>

  <div class="wrap cv">
    <section id="education" aria-labelledby="edu-title">
      <h2 id="edu-title">教育背景</h2>
      <div class="cv-items">
        {education.map((e) => (
          <article class="cv-item">
            <h3>{e.school}</h3>
            <p class="cv-sub">
              <time>{e.period}</time>
              <span>{e.college}</span>
            </p>
            <p>
              {e.degree}｜{e.gpa}
            </p>
            {e.honor && (
              <p class="cv-detail">
                <a href={e.honor.url}>{e.honor.title} ↗</a>
                <span lang="en">{e.honor.text}</span>
              </p>
            )}
            {e.thesis && (
              <p class="cv-detail">
                <b>毕业论文</b>
                <span>{e.thesis}</span>
              </p>
            )}
            {e.teaching && (
              <p class="cv-detail">
                <b>教学经历</b>
                <span>{e.teaching}</span>
              </p>
            )}
            <details class="cv-courses">
              <summary>课程（{e.courses.length}）</summary>
              <ul lang="en">
                {e.courses.map((c) => (
                  <li>{c}</li>
                ))}
              </ul>
            </details>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" aria-labelledby="exp-title">
      <h2 id="exp-title">工作经历</h2>
      <div class="cv-items">
        {experience.map((e) => (
          <article class="cv-item">
            <h3>
              {e.company} <span>{e.role}</span>
            </h3>
            <p class="cv-sub">
              <time>{e.period}</time>
              <span>{e.team}</span>
              {e.unit && <span>{e.unit}</span>}
            </p>
            <ul>
              {e.points.map(([label, text]) => (
                <li>
                  <b>{label}：</b>
                  {text}
                </li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section id="projects" aria-labelledby="proj-title">
      <h2 id="proj-title">项目经历</h2>
      <div class="cv-items">
        {projects.map((p) => (
          <article class="cv-item">
            <h3>{p.page ? <a href={p.page}>{p.title}</a> : p.title}</h3>
            {(p.role || p.period) && (
              <p class="cv-sub">
                {p.period && <time>{p.period}</time>}
                {p.role && <span>{p.role}</span>}
              </p>
            )}
            <ul>
              {p.points.map((t) => (
                <li>{t}</li>
              ))}
            </ul>
            {p.repo && (
              <p class="cv-links">
                <a href={p.repo}>代码 ↗</a>
              </p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="research" aria-labelledby="res-title">
      <h2 id="res-title">研究经历</h2>
      <div class="cv-items">
        <article class="cv-item">
          <h3 lang="en">{research.title}</h3>
          <p class="cv-sub">
            <span>{research.venue}</span>
            <span>{research.role}</span>
            <time>{research.date}</time>
          </p>
          <p>{research.text}</p>
          <p class="cv-links">
            <a href={research.url}>论文 ↗</a>
            <a href="/work/probabilistic-imaging/">研究详情</a>
          </p>
        </article>
      </div>
    </section>

    <section id="activities" aria-labelledby="act-title">
      <h2 id="act-title">其他经历</h2>
      <div class="cv-items">
        {activities.map((a) => (
          <article class="cv-item">
            <h3>{a.title}</h3>
            <p>{a.text}</p>
          </article>
        ))}
      </div>
    </section>
  </div>
</Base>
