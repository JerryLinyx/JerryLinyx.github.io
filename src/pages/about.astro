---
import Base from "../layouts/Base.astro";
import { mediaSize } from "../lib/content.mjs";
import {
  profile,
  education,
  experience,
  publication,
  projects,
  otherProjects,
  tools,
} from "../data/portfolio.js";
const aid3 = projects.find((p) => p.slug === "aid3");
const engineering = projects.filter((p) =>
  ["fingoat", "pacc", "cuda-lenet", "linux-kernel"].includes(p.slug),
);
---

<Base
  title="关于 · 林煜轩"
  description="林煜轩的教育、研究、工程经历与联系信息。"
  section="about"
>
  <header class="wrap about-head">
    <div class="about-intro">
      <h1>
        林煜轩 <span>Yuxuan Lin</span>
      </h1>
      <p class="about-focus">{profile.focus}</p>
      <p class="lead">{profile.intro}</p>
      <p class="about-links">
        <a href={`mailto:${profile.email}`}>Email</a>
        <a href={profile.github}>GitHub ↗</a>
        <a href={profile.linkedin}>LinkedIn ↗</a>
        <button type="button" class="link-button" data-print>
          打印简历
        </button>
      </p>
    </div>
    <figure class="portrait">
      <img
        src="/media/portrait.webp"
        alt="林煜轩站在红墙前"
        {...mediaSize("/media/portrait.webp")}
        fetchpriority="high"
      />
    </figure>
  </header>

  <div class="wrap cv">
    <section id="education" aria-labelledby="edu-title">
      <h2 id="edu-title">Education</h2>
      <div class="cv-items">
        {education.map((e) => (
          <article class="cv-item">
            <h3>{e.school}</h3>
            <p class="cv-sub">{e.degree}</p>
            <p>{e.text}</p>
          </article>
        ))}
      </div>
    </section>

    <section id="experience" aria-labelledby="exp-title">
      <h2 id="exp-title">Experience</h2>
      <div class="cv-items">
        {experience.map((e) => (
          <article class="cv-item">
            <h3>
              {e.company} <span>{e.role}</span>
            </h3>
            <p class="cv-sub">
              <time>{e.period}</time>
              {e.team && <span>{e.team}</span>}
            </p>
            {e.points.length > 1 ? (
              <ul>
                {e.points.map((t) => (
                  <li>{t}</li>
                ))}
              </ul>
            ) : (
              <p>{e.points[0]}</p>
            )}
          </article>
        ))}
      </div>
    </section>

    <section id="research" aria-labelledby="res-title">
      <h2 id="res-title">Research</h2>
      <div class="cv-items">
        <article class="cv-item">
          <h3>{publication.title}</h3>
          <p class="cv-sub">
            <span>{publication.venue}</span>
            <span>{publication.role}</span>
            <span>{publication.date}</span>
          </p>
          <p class="authors">
            {publication.authors.map((a, i) => (
              <>
                {a === profile.name ? <strong>{a}</strong> : a}
                {i < publication.authors.length - 1 && ", "}
              </>
            ))}
          </p>
          <p>{publication.text}</p>
          <p class="cv-links">
            <a href={publication.paper}>论文 ↗</a>
            <a href={publication.project}>研究详情</a>
            <a href={publication.code}>代码 ↗</a>
          </p>
        </article>
        <article class="cv-item">
          <h3>
            Zhejiang University ICI Lab <span>科研助理</span>
          </h3>
          <p>{aid3.description}</p>
          <p class="cv-links">
            <a href="/work/aid3/">项目</a>
            <a href={aid3.repo}>代码 ↗</a>
          </p>
        </article>
      </div>
    </section>

    <section id="projects" aria-labelledby="proj-title">
      <h2 id="proj-title">Selected engineering projects</h2>
      <ul class="cv-items cv-list">
        {engineering.map((p) => (
          <li>
            <a href={`/work/${p.slug}/`}>{p.title}</a>
            <span>{p.description}</span>
          </li>
        ))}
        {otherProjects.map((t) => {
          const [name, text] = t.split(" — ");
          return (
            <li>
              <b>{name}</b>
              <span>{text}</span>
            </li>
          );
        })}
      </ul>
    </section>

    <section id="tools" aria-labelledby="tools-title">
      <h2 id="tools-title">Tools I work with</h2>
      <dl class="cv-items tools">
        {tools.map(([k, v]) => (
          <div>
            <dt>{k}</dt>
            <dd>{v}</dd>
          </div>
        ))}
      </dl>
    </section>
    <p class="footnote cv-note">
      项目数据根据个人简历整理，属于对应项目和测试场景中的结果。
    </p>
  </div>
</Base>
