---
import Base from "../layouts/Base.astro";
import SectionHead from "../components/SectionHead.astro";
import { researchPost } from "../lib/content.mjs";
const trails = [
  {
    number: "01",
    title: "生成式模型与成像",
    english: "GENERATIVE MODELS",
    description: "如何从观测推断图像，又如何衡量推断的不确定性？",
    slugs: [
      "algo/dpi",
      "algo/flow-based-model",
      "algo/flow-matching",
      "algo/vae",
    ],
  },
  {
    number: "02",
    title: "模型背后的系统",
    english: "EFFICIENT SYSTEMS",
    description: "从 GPU 内核到分布式训练，理解计算与通信的成本。",
    slugs: [
      "hpc/cuda",
      "training/distributed-training",
      "hpc/nvidia-architecture",
      "inference/inference",
    ],
  },
  {
    number: "03",
    title: "让模型进入应用",
    english: "AI IN PRACTICE",
    description: "检索、推理与评估：把模型能力放进完整的使用流程。",
    slugs: ["application/rag", "application/evaluation", "algo/transformer"],
  },
];
---

<Base title="研究 · 林煜轩" section="research">
  <section class="page-heading wrap">
    <p class="eyebrow">02 / RESEARCH OBSERVATORY</p>
    <h1>
      观察有限，<span>问题没有边界。</span>
    </h1>
    <div class="heading-bottom">
      <p>
        生成式模型、概率成像与高效系统。
        <br />
        从论文里的一个问题，走向可以验证的理解。
      </p>
      <span class="mono">RESEARCH & LEARNING TRAILS</span>
    </div>
  </section>
  <section class="publication wrap">
    <div class="publication-label">
      <span class="eyebrow">PUBLICATION / 2026</span>
      <span class="publication-stamp">
        IEEE
        <br />
        <em>ISBI</em>
        <br />
        2026
      </span>
    </div>
    <div class="publication-body">
      <p class="eyebrow">BAYESIAN INFERENCE × MEDICAL IMAGING</p>
      <h2>Bayesian PET Reconstruction with Learned Normalizing Flow Priors</h2>
      <p class="authors">
        Hengjia Ran, <strong>Yuxuan Lin</strong>, Huafeng Liu, Bo Zhao
      </p>
      <p>
        用学习得到的归一化流先验研究 PET
        图像重建，在图像质量之外，进一步理解后验分布与不确定性。
      </p>
      <p class="muted">
        IEEE International Symposium on Biomedical Imaging · 2026 年 4 月 ·
        第二作者
      </p>
      <div class="inline-links">
        <a
          class="button"
          href="https://ieeexplore.ieee.org/abstract/document/11515791"
        >
          阅读论文 ↗
        </a>
        <a class="text-link" href="/work/probabilistic-imaging/">
          研究工作 ↗
        </a>
      </div>
    </div>
  </section>
  <section class="wrap trails">
    <SectionHead
      number="RESEARCH TRAILS"
      label="CONNECTED LEARNING"
      title="三个仍在展开的问题。"
    />
    {trails.map((t) => (
      <div class="trail">
        <div>
          <p class="eyebrow">
            {t.number} / {t.english}
          </p>
          <h3>{t.title}</h3>
          <p>{t.description}</p>
        </div>
        <ol>
          {t.slugs
            .map((s) => researchPost(s))
            .filter(Boolean)
            .map((p, i) => (
              <li>
                <a href={p.url}>
                  <span class="mono">0{i + 1}</span>
                  {p.title}
                  <span aria-hidden="true">↗</span>
                </a>
              </li>
            ))}
        </ol>
      </div>
    ))}
  </section>
  <section class="wrap research-note">
    <span class="note-symbol" aria-hidden="true">
      ✳
    </span>
    <div>
      <h2>研究也发生在工程里。</h2>
      <p>
        PACC 将真实的训练轨迹与能耗分析连接；FinGOAT 探索多智能体并行推理。
        <br />
        理解与构建，常常沿着同一条路前进。
      </p>
      <a class="text-link" href="/work/">
        看看相关作品 ↗
      </a>
    </div>
  </section>
</Base>
