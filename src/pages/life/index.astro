---
import Base from "../../layouts/Base.astro";
import { photos, mediaSize } from "../../lib/content.mjs";
// Text is the original photo log: plog/2025-07-10-Singapore/index.mdx.
---

<Base
  title="Singapore · Water & Light · 林煜轩"
  description="Rain suspended mid-air, river lights refusing to sleep, and glass gardens humming after dark."
  section="life"
>
  <header class="wrap page-head album-head">
    <h1>Singapore · Water & Light</h1>
    <div class="album-intro">
      <p class="lead">
        雨幕自穹顶倾泻，河水裹挟霓虹缓缓回旋。我循着湿润而鲜明的线索，徐行在这座城市。
        <br />
        每一帧都维持原初的呼吸节奏，只轻轻调校色彩，将南洋的水汽同盛夏一并封存。
      </p>
      <p class="album-meta">
        Shot on Apple iPhone 16 Pro · 24&nbsp;mm f/1.78 & 120&nbsp;mm f/2.8
        <br />
        July&nbsp;8-10,&nbsp;2025 · Singapore, SG
      </p>
    </div>
  </header>
  <section class="wrap gallery" aria-label="照片">
    {photos.map((p, i) => (
      <figure id={`photo-${i + 1}`} class:list={["shot", `shot-${i + 1}`]}>
        <button
          type="button"
          data-photo={i}
          data-src={p.url}
          data-alt={p.alt}
          data-caption={`${p.title} · ${p.english}${p.caption ? "。" + p.caption : ""}`}
          aria-label={`放大查看：${p.title}`}
        >
          <img
            src={p.url}
            alt={p.alt}
            {...mediaSize(p.url)}
            loading={i < 2 ? "eager" : "lazy"}
            decoding="async"
          />
        </button>
        <figcaption>
          <strong>{p.title}</strong> · {p.english}
          {p.caption && <span>{p.caption}</span>}
        </figcaption>
      </figure>
    ))}
  </section>
  <section class="wrap album-end" aria-labelledby="behind">
    <h2 id="behind">Behind the Frame</h2>
    <p>
      若你也想感受狮城的脉搏，可以从午后的克拉码头启程，沿着新加坡河走到滨海湾——流水和光影会替你规划好每一幕。
    </p>
  </section>
  <dialog class="lightbox" aria-label="照片查看器">
    <figure>
      <img src={photos[0].url} alt="" />
      <figcaption></figcaption>
    </figure>
    <p
      class="lightbox-status"
      role="status"
      aria-live="polite"
      data-gallery-status
      hidden
    ></p>
    <div class="lightbox-bar">
      <span class="lightbox-count"></span>
      <button type="button" class="link-button" data-gallery-retry hidden>
        重试
      </button>
      <button type="button" class="lightbox-prev" aria-label="上一张">
        ←
      </button>
      <button type="button" class="lightbox-next" aria-label="下一张">
        →
      </button>
      <button type="button" class="lightbox-close">
        关闭
      </button>
    </div>
  </dialog>
</Base>
