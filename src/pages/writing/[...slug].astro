---
import Base from "../../layouts/Base.astro";
import { posts, renderPost } from "../../lib/content.mjs";
import "katex/dist/katex.min.css";
export function getStaticPaths() {
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: { post },
  }));
}
const { post } = Astro.props;
const rendered = await renderPost(post);
const related = posts
  .filter((p) => p.slug !== post.slug && p.topic === post.topic)
  .slice(0, 3);
const hasToc = rendered.headings.length > 2;
---

<Base
  title={`${post.title} · 林煜轩`}
  description={post.description}
  section="writing"
  article
>
  <div class="progress" aria-hidden="true">
    <span></span>
  </div>
  <article class="wrap reader">
    <header class="reader-head">
      <a href="/writing/" class="back">
        写作
      </a>
      <h1>{post.title}</h1>
      <p class="reader-meta">
        <span>
          {post.kind === "notes" ? "笔记" : "文章"}，{post.topic}
        </span>
        {post.date && (
          <time datetime={post.date}>{post.date.replaceAll("-", ".")}</time>
        )}
        <span>{post.minutes} 分钟阅读</span>
        <button type="button" class="link-button" data-copy-link>
          复制链接
        </button>
      </p>
    </header>
    <div class:list={["reader-layout", { "has-toc": hasToc }]}>
      {hasToc && (
        <aside class="toc">
          <details open>
            <summary>目录</summary>
            <nav aria-label="文章目录">
              {rendered.headings.map((h) => (
                <a href={`#${h.id}`} class:list={{ sub: h.level === 3 }}>
                  {h.text}
                </a>
              ))}
            </nav>
          </details>
        </aside>
      )}
      <div class="prose" set:html={rendered.html} />
    </div>
    <footer class="reader-end">
      {related.length > 0 && (
        <section aria-labelledby="related-title">
          <h2 id="related-title">同一主题</h2>
          <ul>
            {related.map((p) => (
              <li>
                <a href={p.url}>{p.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
      <a class="inline-more" href="/writing/">
        全部文字
      </a>
    </footer>
  </article>
</Base>
