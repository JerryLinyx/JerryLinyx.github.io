---
import Base from "../../layouts/Base.astro";
import { legacy, oldRoutes, archiveCanonical } from "../../lib/content.mjs";
---

<Base title="旧日存档 · 林煜轩">
  <header class="wrap page-head">
    <h1>旧日存档</h1>
    <p class="lead">
      2024
      年早期博客与过去的个人主页，按原样保留，内容可能不再适用于今天。与现行文章正文相同的条目，直接指向现行版本。
    </p>
  </header>
  <section class="wrap" aria-label="历史条目">
    <ul class="archive">
      {legacy.articles.map((a) => {
        const shared = archiveCanonical.get(a.archive);
        return (
          <li>
            <time>{a.date.replaceAll("-", ".")}</time>
            <a href={shared || a.archive}>{a.title}</a>
            <span>
              {shared ? (
                "已并入现行文章"
              ) : (
                <a href={oldRoutes.get(a.canonical) || a.canonical}>现行版本</a>
              )}
            </span>
          </li>
        );
      })}
      {legacy.extras.map((a) => (
        <li>
          <time>早期网页</time>
          <a href={a.archive}>{a.title}</a>
          <span />
        </li>
      ))}
      <li>
        <time>2025</time>
        <a href="/archive/cv/">个人简历（历史版本）</a>
        <span>
          <a href="/about/">现行简介</a>
        </span>
      </li>
    </ul>
  </section>
</Base>
