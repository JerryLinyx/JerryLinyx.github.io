---
import Base from "../layouts/Base.astro";
import FlowHero from "../components/FlowHero.astro";
import WorkIndex from "../components/WorkIndex.astro";
import Montage from "../components/Montage.astro";
import { posts, photos, readingRoutes, mediaSize } from "../lib/content.mjs";
import { projects, publication, education } from "../data/portfolio.js";
---

<Base home>
  <FlowHero />

  <section class="wrap facts" aria-label="简介">
    <dl>
      <div>
        <dt>现在</dt>
        <dd>
          <a href="/about/#education">{education[0].school}</a>
          <span>{education[0].degree}</span>
        </dd>
      </div>
      <div>
        <dt>本科</dt>
        <dd>
          <a href="/about/#education">Zhejiang University × UIUC</a>
          <span>ZJU–UIUC 双学位项目</span>
        </dd>
      </div>
      <div>
        <dt>论文</dt>
        <dd>
          <a href="/about/#research">{publication.venue}</a>
          <span>{publication.role}</span>
        </dd>
      </div>
    </dl>
  </section>

  <Montage />

  <section class="wrap block" aria-labelledby="work-title">
    <header class="block-head">
      <h2 id="work-title">作品</h2>
      <a class="more" href="/work/">
        全部 {projects.length} 个项目
      </a>
    </header>
    <WorkIndex items={projects} />
  </section>

  <section class="wrap block" aria-labelledby="writing-title">
    <header class="block-head">
      <h2 id="writing-title">写作</h2>
      <a class="more" href="/writing/">
        全部 {posts.length} 篇文字
      </a>
    </header>
    <div class="routes">
      <p class="routes-lead">从一个问题开始</p>
      <ul>
        {readingRoutes.map((r) => (
          <li>
            <span class="route-q">{r.question}</span>
            <span class="route-links">
              {r.posts.map((p) => (
                <a href={p.url}>{p.title}</a>
              ))}
            </span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="block life-teaser" aria-labelledby="life-title">
    <header class="wrap block-head">
      <h2 id="life-title">生活</h2>
      <a class="more" href="/life/">
        Singapore · Water & Light
      </a>
    </header>
    <div class="strip" tabindex="0" aria-label="新加坡照片，可横向滚动">
      {photos.map((p, i) => (
        <a href={`/life/#photo-${i + 1}`} class="strip-item">
          <img
            src={p.url}
            alt={p.alt}
            loading="lazy"
            decoding="async"
            {...mediaSize(p.url)}
          />
          <span>{p.title}</span>
        </a>
      ))}
    </div>
  </section>
</Base>
