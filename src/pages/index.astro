---
import Base from "../layouts/Base.astro";
import { posts } from "../lib/content.mjs";
import { projects, moreProjects } from "../data/portfolio.js";
const sections = [
  {
    no: "01",
    title: "作品",
    en: "Making",
    href: "/work/",
    count: `${projects.length + moreProjects.length} 个项目`,
    text: "让想法落在真实的系统里。",
  },
  {
    no: "02",
    title: "研究",
    en: "Questions",
    href: "/research/",
    count: "1 篇论文 · 3 条学习路径",
    text: "在模型、成像与系统之间追问。",
  },
  {
    no: "03",
    title: "写作",
    en: "Writing",
    href: "/writing/",
    count: `${posts.length} 篇整理后的文字`,
    text: "文章、笔记，以及相互连接的理解。",
  },
  {
    no: "04",
    title: "生活",
    en: "Outside",
    href: "/life/",
    count: "1 本影集 · 9 张照片",
    text: "在屏幕以外，慢慢观察。",
  },
];
const entries = [
  {
    label: "01 / WORK",
    title: "FinGOAT",
    description: "关于多智能体如何共同完成研究。",
    href: "/work/fingoat/",
  },
  {
    label: "02 / RESEARCH",
    title: "Probabilistic imaging",
    description: "重建图像，也理解不确定性。",
    href: "/research/",
  },
  {
    label: "03 / WRITING",
    title: "Road to Flow Matching",
    description: "沿着可逆变换，走向连续时间的生成模型。",
    href: "/writing/articles/road-to-flow-matching/",
  },
  {
    label: "04 / LIFE",
    title: "Singapore, after dark",
    description: "从雨漩涡到超级树，九张路上的记录。",
    href: "/life/singapore/",
  },
];
---

<Base>
  <section class="zine-cover wrap" aria-labelledby="cover-title">
    <div class="cover-meta mono">
      <span>PERSONAL INDEX / VOL. 01</span>
      <span>林煜轩 · YUXUAN LIN</span>
    </div>
    <div class="cover-words">
      <p class="eyebrow">A SMALL COLLECTION OF THINGS</p>
      <h1 id="cover-title">
        作品，问题，
        <br />
        和沿途的事。
      </h1>
      <p>
        我在这里整理做过的东西、
        <br />
        正在理解的问题，以及生活的片刻。
      </p>
      <a href="#index" class="cover-enter">
        从索引开始 <span aria-hidden="true">↓</span>
      </a>
    </div>
    <figure class="cover-fragment">
      <div class="fragment-photo">
        <img
          src="/media/portrait.webp"
          alt="林煜轩站在红墙旁，个人照片以印刷片段呈现"
          width="180"
          height="225"
          fetchpriority="high"
        />
      </div>
      <div class="ink-slip" aria-hidden="true">
        <span>
          collected
          <br />
          along
          <br />
          the way.
        </span>
        <small>YL / 001</small>
      </div>
      <figcaption class="mono">
        一些想法，
        <br />
        在这里慢慢成形。
      </figcaption>
      <span class="registration" aria-hidden="true">
        +
      </span>
    </figure>
    <div class="cover-foot mono">
      <span>NEW YORK, US</span>
      <p>创造 / 理解 / 记录 / 生活</p>
      <span>SCROLL TO EXPLORE ↘</span>
    </div>
  </section>
  <section class="wrap zine-directory" id="index" aria-label="内容索引">
    {sections.map((s) => (
      <a href={s.href}>
        <span class="directory-top mono">
          {s.no} / {s.en}
          <i aria-hidden="true">↗</i>
        </span>
        <h2>{s.title}</h2>
        <p>{s.text}</p>
        <span class="directory-count">{s.count}</span>
      </a>
    ))}
  </section>
  <section class="wrap zine-spread">
    <div class="spread-side">
      <p class="eyebrow">SELECTED PAGES</p>
      <h2>
        几页，
        <br />
        从这里翻起。
      </h2>
      <figure>
        <a href="/life/singapore/" aria-label="进入新加坡影集">
          <img
            src="/media/singapore-6.webp"
            alt="新加坡牛车水的街巷，旅途中的一张照片"
            width="300"
            height="360"
            loading="lazy"
          />
        </a>
        <figcaption class="mono">A WALK / SINGAPORE, 2025</figcaption>
      </figure>
    </div>
    <div class="spread-index">
      {entries.map((e) => (
        <a href={e.href}>
          <span class="eyebrow">{e.label}</span>
          <h3>{e.title}</h3>
          <p>{e.description}</p>
          <span class="spread-arrow" aria-hidden="true">
            ↗
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="wrap zine-colophon">
    <span class="mono">A NOTE FROM THE EDITOR</span>
    <div>
      <p>
        你好，我是林煜轩。
        <br />
        计算机工程、生成式模型与系统，是我的学习和实践方向。
        <br />
        这本个人索引，也为生活里的细小发现留一些空白。
      </p>
      <a href="/about/" class="text-link">
        关于我 ↗
      </a>
    </div>
    <a class="colophon-archive" href="/archive/">
      旧日文字与版本记录 ↗
    </a>
  </section>
</Base>
