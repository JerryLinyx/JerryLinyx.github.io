---
import Base from "../layouts/Base.astro";
import Instrument from "../components/Instrument.astro";
import FieldVisual from "../components/FieldVisual.astro";
import { posts } from "../lib/content.mjs";
import { projects } from "../data/portfolio.js";
const selected = [projects[2], projects[0], projects[1]];
const fieldTypes = ["flow", "network", "terrain"];
const inquiries = [
  "从有限的观测，如何推断未知？",
  "多个智能体，如何形成共同的判断？",
  "一次训练的成本，究竟发生在哪里？",
];
const writing = [
  "articles/road-to-flow-matching",
  "notes/hpc/cuda",
  "notes/application/rag",
]
  .map((slug) => posts.find((p) => p.slug === slug))
  .filter(Boolean);
---

<Base>
  <section class="observatory wrap" aria-labelledby="home-title">
    <div class="observatory-index mono">
      <span>PERSONAL OBSERVATORY — 2026</span>
      <span>YUXUAN LIN / 林煜轩</span>
      <span>NEW YORK, US</span>
    </div>
    <div class="hero-typography">
      <p class="eyebrow">ENGINEERING · GENERATIVE MODELS · SYSTEMS</p>
      <h1 id="home-title">
        A question
        <br />
        <em>takes form.</em>
      </h1>
      <p class="hero-chinese">从问题出发，让理解成形。</p>
      <p class="hero-intro">
        我是林煜轩。研究生成式模型，构建真实系统，
        <br />
        也记录世界在日常里显露的结构。
      </p>
      <a href="#investigations" class="archive-link">
        进入作品档案 <span aria-hidden="true">↘</span>
      </a>
    </div>
    <Instrument />
    <div class="hero-footer mono">
      <span>OBSERVE → MODEL → EXPERIMENT</span>
      <span>AN ONGOING INQUIRY</span>
      <a href="#investigations">SCROLL TO DISCOVER ↓</a>
    </div>
  </section>
  <section class="archive-manifesto wrap" data-reveal>
    <p class="eyebrow">A NOTE ON THE WORK</p>
    <h2>
      信息成为结构，
      <br />
      结构产生关系，
      <br />
      <span>理解由此发生。</span>
    </h2>
    <div>
      <p>
        我的工作横跨生成式模型、AI 应用和计算系统。
        <br />
        在抽象的想法与真实的约束之间，寻找可以验证的答案。
      </p>
      <a class="text-link" href="/about/">
        关于我与这条路径 ↗
      </a>
    </div>
    <span class="manifesto-registration" aria-hidden="true">
      +
    </span>
  </section>
  <section
    class="investigations"
    id="investigations"
    aria-labelledby="work-title"
  >
    <header class="archive-section-head wrap">
      <div>
        <p class="eyebrow">01 / SELECTED INVESTIGATIONS</p>
        <h2 id="work-title">
          三个问题。<em>三次探索。</em>
        </h2>
      </div>
      <a class="text-link" href="/work/">
        全部 6 个项目 ↗
      </a>
    </header>
    {selected.map((p, i) => (
      <article class:list={["investigation", `investigation-${i}`]} data-reveal>
        <div class="investigation-inner wrap">
          <div class="investigation-visual">
            <div class="specimen-top mono">
              <span>SPECIMEN / 00{i + 1}</span>
              <span>{["PROBABILITY", "REASONING", "COMPUTATION"][i]}</span>
            </div>
            <FieldVisual kind={fieldTypes[i]} />
            <div class="specimen-bottom mono">
              <span>MATHEMATICAL FORM STUDY</span>
              <span aria-hidden="true">∴</span>
            </div>
            <span class="specimen-tab mono">{p.year}</span>
          </div>
          <div class="investigation-text">
            <p class="eyebrow">{p.category}</p>
            <p class="inquiry">{inquiries[i]}</p>
            <h3>
              <a href={`/work/${p.slug}/`}>{p.title}</a>
            </h3>
            <p>{p.description}</p>
            <div class="investigation-fact">
              <span class="mono">
                {["RESEARCH OUTPUT", "PROJECT OBSERVATION", "METHOD & ROLE"][i]}
              </span>
              <p>
                {i === 0
                  ? "IEEE ISBI 2026 · 第二作者"
                  : i === 1
                    ? "图编排、并行推理与完整推理链路"
                    : "团队项目 · 多 GPU 事件采集与格式转换"}
              </p>
            </div>
            <a class="archive-link" href={`/work/${p.slug}/`}>
              查看研究与构建过程 <span aria-hidden="true">↗</span>
            </a>
          </div>
        </div>
      </article>
    ))}
  </section>
  <section class="research-desk wrap" data-reveal>
    <div class="desk-heading">
      <p class="eyebrow">02 / WORKING NOTES</p>
      <h2>思考的中间态。</h2>
      <p>
        一些已成文的理解，
        <br />
        以及仍然开放的问题。
      </p>
      <div class="desk-links">
        <a href="/research/" class="text-link">
          论文与研究线索 ↗
        </a>
        <a href="/writing/" class="text-link">
          {posts.length} 篇文章与笔记 ↗
        </a>
      </div>
    </div>
    <div class="desk-pages">
      {writing.map((p, i) => (
        <a class="desk-page" href={p.url}>
          <span class="mono">
            NOTE / {String(i + 1).padStart(3, "0")}
            <span aria-hidden="true">↗</span>
          </span>
          <h3>{p.title}</h3>
          <p>{p.description}</p>
          <span class="mono desk-page-meta">
            {p.topic} / {p.minutes} MIN READ
          </span>
        </a>
      ))}
    </div>
  </section>
  <section class="outside-frame wrap" data-reveal>
    <a class="outside-image" href="/life/singapore/">
      <img
        src="/media/singapore-8.webp"
        alt="新加坡滨海湾花园的夜景，灯光中的树形结构"
        width="1400"
        height="900"
        loading="lazy"
      />
      <span class="outside-image-label mono">
        OBSERVATION / SINGAPORE, 2025
      </span>
    </a>
    <div class="outside-caption">
      <p class="eyebrow">03 / OUTSIDE THE MODEL</p>
      <h2>
        世界始终比模型<em>更丰富。</em>
      </h2>
      <p>离开屏幕，走进真实的光线、街道和时间。</p>
      <a class="archive-link" href="/life/">
        生活与摄影 <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</Base>
