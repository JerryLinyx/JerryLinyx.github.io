---
import "../styles/garden.css";
const {
  title = "林煜轩 · 个人数字花园",
  description = "林煜轩的个人数字花园。记录作品、研究、学习与日常，让好奇心慢慢生长。",
  section = "",
  article = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://jerrylinyx.github.io/");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: "Yuxuan Lin",
  alternateName: "林煜轩",
  url: "https://jerrylinyx.github.io/",
  sameAs: [
    "https://github.com/JerryLinyx",
    "https://www.linkedin.com/in/yuxuan0/",
  ],
};
const nav = [
  ["work", "作品", "/work/"],
  ["research", "研究", "/research/"],
  ["writing", "写作", "/writing/"],
  ["life", "生活", "/life/"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f4ed" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://jerrylinyx.github.io/social-garden.png"
    />
    <link rel="icon" type="image/svg+xml" href="/garden-icon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="林煜轩 · 写作"
      href="/feed.xml"
    />
    <link
      rel="preload"
      href="/fonts/jizBRFtNs2ka5fXjeivQ4LroWlx-2zI.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body>
    <a class="skip" href="#main">
      跳到主要内容
    </a>
    <header class="header">
      <a class="wordmark" href="/" aria-label="林煜轩，花园首页">
        <svg viewBox="0 0 36 36" fill="none" aria-hidden="true">
          <path
            d="M18 30V13M18 21C5 23 4 11 5 6c9-1 14 5 13 15ZM18 17C29 18 33 9 31 4c-9 0-14 5-13 13Z"
            stroke="currentColor"
            stroke-width="1.6"
          />
        </svg>
        <span>
          林煜轩<small>YUXUAN LIN</small>
        </span>
      </a>
      <nav class="desktop-nav" aria-label="主导航">
        {nav.map(([key, label, url]) => (
          <a href={url} aria-current={section === key ? "page" : undefined}>
            {label}
            <span>
              {key === "work"
                ? "MAKE"
                : key === "research"
                  ? "STUDY"
                  : key === "writing"
                    ? "WRITE"
                    : "LIVE"}
            </span>
          </a>
        ))}
      </nav>
      <div class="header-end">
        <a
          class:list={["about-link", { active: section === "about" }]}
          href="/about/"
        >
          关于我 <span aria-hidden="true">↗</span>
        </a>
        <button
          class="menu-toggle"
          type="button"
          aria-label="展开导航"
          aria-expanded="false"
          aria-controls="mobile-nav"
        >
          <span></span>
          <span></span>
        </button>
      </div>
      <nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航" hidden>
        {nav.map(([key, label, url], i) => (
          <a href={url}>
            <span class="mono">0{i + 1}</span>
            {label}
            <span aria-hidden="true">↗</span>
          </a>
        ))}
        <a href="/about/">
          <span class="mono">05</span>关于我<span aria-hidden="true">↗</span>
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-top">
        <p>
          保持好奇。
          <br />
          <span>让想法继续生长。</span>
        </p>
        <a class="contact" href="mailto:yl6061@columbia.edu">
          来打个招呼 <span aria-hidden="true">↗</span>
          <small>yl6061@columbia.edu</small>
        </a>
      </div>
      <div class="footer-bottom">
        <span class="mono">© 2026 YUXUAN LIN</span>
        <div>
          <a href="https://github.com/JerryLinyx">GitHub ↗</a>
          <a href="/archive/">旧日存档</a>
          <a href="/feed.xml">RSS</a>
          <a href="#top" data-backtop>
            回到顶部 ↑
          </a>
        </div>
        <span class="footer-note">一片持续生长的数字花园</span>
      </div>
    </footer>
    <script src="../scripts/garden.js"></script>
  </body>
</html>
