---
import "../styles/site.css";
import { profile } from "../data/portfolio.js";
const {
  title = "林煜轩 Yuxuan Lin",
  description = profile.description,
  section = "",
  article = false,
  home = false,
} = Astro.props;
const canonical = new URL(Astro.url.pathname, "https://jerrylinyx.github.io/");
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.chineseName,
  url: "https://jerrylinyx.github.io/",
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin],
};
const nav = [
  ["work", "作品", "/work/"],
  ["writing", "写作", "/writing/"],
  ["life", "生活", "/life/"],
  ["about", "关于", "/about/"],
];
---

<!doctype html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#f1f1ee"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121316"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://jerrylinyx.github.io/social-preview.png"
    />
    <link rel="icon" type="image/svg+xml" href="/site-icon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title="林煜轩 · 写作"
      href="/feed.xml"
    />
    <link
      rel="preload"
      href="/fonts/xn7_YHE41ni1AdIRqAuZuw1Bx9mbZk7PFO_F.ttf"
      as="font"
      type="font/ttf"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class:list={{ "is-home": home }}>
    <a class="skip" href="#main">
      跳到主要内容
    </a>
    <header class="header">
      <a class="wordmark" href="/" aria-current={home ? "page" : undefined}>
        林煜轩<span>Yuxuan Lin</span>
      </a>
      <nav class="nav" aria-label="主导航">
        {nav.map(([key, label, url]) => (
          <a href={url} aria-current={section === key ? "page" : undefined}>
            {label}
          </a>
        ))}
      </nav>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">打开导航</span>
        <i aria-hidden="true"></i>
      </button>
      <nav class="mobile-nav" id="mobile-nav" aria-label="移动端导航" hidden>
        {nav.map(([key, label, url]) => (
          <a href={url} aria-current={section === key ? "page" : undefined}>
            {label}
          </a>
        ))}
        <a class="mobile-mail" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-contact">
          <p>聊聊 AI、系统，或一个尚未成形的想法。</p>
          <a class="footer-mail" href={`mailto:${profile.email}`}>
            {profile.email}
          </a>
        </div>
        <div class="footer-links">
          <a href={profile.github}>GitHub ↗</a>
          <a href={profile.linkedin}>LinkedIn ↗</a>
          <a href="/feed.xml">RSS</a>
          <a href="/archive/">旧日存档</a>
        </div>
        <p class="endcard" aria-hidden="true">
          林煜轩
        </p>
        <p class="footer-meta">
          <span>© 2026 Yuxuan Lin</span>
          <a href="#top" data-backtop>
            回到顶部
          </a>
        </p>
      </div>
    </footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
