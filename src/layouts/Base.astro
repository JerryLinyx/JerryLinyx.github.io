---
import "@fontsource-variable/noto-sans/wght.css";
import "@fontsource-variable/source-serif-4/opsz.css";
import "../styles/site.css";
import { localPath, portfolio, translated, ui } from "../i18n.js";
const path = Astro.url.pathname;
const lang = path.startsWith("/en/") || path === "/en" ? "en" : "zh";
const t = ui[lang];
const { profile } = portfolio[lang];
const {
  title = t.siteTitle,
  description = profile.description,
  section = "",
  article = false,
  home = false,
} = Astro.props;
const site = "https://jerrylinyx.github.io";
const canonical = new URL(path, site + "/");
// The same page in each language, when it has been translated.
const zhPath = lang === "en" ? path.slice(3) || "/" : path;
const pair = translated(zhPath) ? { zh: zhPath, en: "/en" + zhPath } : null;
const other = lang === "en" ? "zh" : "en";
const switchHref = pair ? pair[other] : other === "en" ? "/en/" : "/";
const structuredData = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: profile.name,
  alternateName: profile.chineseName,
  url: "https://jerrylinyx.github.io/",
  email: `mailto:${profile.email}`,
  sameAs: [profile.github, profile.linkedin],
};
const nav = ["work", "writing", "life", "about"].map((key) => {
  const url = localPath(lang, `/${key}/`);
  return {
    key,
    url,
    label: t.nav[key],
    zhOnly: lang === "en" && !url.startsWith("/en/"),
  };
});
---

<!doctype html>
<html lang={t.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta
      name="theme-color"
      content="#f1f1ee"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#121316"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="color-scheme" content="light dark" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {pair && (
      <>
        <link rel="alternate" hreflang="zh-CN" href={site + pair.zh} />
        <link rel="alternate" hreflang="en" href={site + pair.en} />
        <link rel="alternate" hreflang="x-default" href={site + pair.zh} />
      </>
    )}
    <meta property="og:locale" content={lang === "en" ? "en_US" : "zh_CN"} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content={article ? "article" : "website"} />
    <meta property="og:url" content={canonical} />
    <meta
      property="og:image"
      content="https://jerrylinyx.github.io/social-preview.png"
    />
    <link rel="icon" type="image/svg+xml" href="/site-icon.svg" />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={t.feedTitle}
      href="/feed.xml"
    />
    <link rel="preload" href="/img/signature.svg" as="image" />
    <link
      rel="preload"
      href="/fonts/site-song.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="generator" content={Astro.generator} />
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    />
  </head>
  <body class:list={{ "is-home": home }}>
    <a class="skip" href="#main">
      {t.skip}
    </a>
    <header class="header">
      <a
        class="wordmark"
        href={lang === "en" ? "/en/" : "/"}
        aria-current={home ? "page" : undefined}
      >
        <span class="signature" role="img" aria-label="林煜轩"></span>
        <span>Yuxuan Lin</span>
      </a>
      <nav class="nav" aria-label={t.navLabel}>
        {nav.map(({ key, url, label, zhOnly }) => (
          <a
            href={url}
            hreflang={zhOnly ? "zh-CN" : undefined}
            aria-current={section === key ? "page" : undefined}
          >
            {label}
            {zhOnly && <small class="zh-only">{t.zhOnly}</small>}
          </a>
        ))}
        <a
          class="lang-switch"
          href={switchHref}
          hreflang={other === "en" ? "en" : "zh-CN"}
          lang={other === "en" ? "en" : "zh-CN"}
          aria-label={t.switchLabel}
        >
          {t.switchText}
        </a>
      </nav>
      <button
        class="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <span class="sr-only">{t.openMenu}</span>
        <i aria-hidden="true"></i>
      </button>
      <nav
        class="mobile-nav"
        id="mobile-nav"
        aria-label={t.mobileNavLabel}
        hidden
      >
        {nav.map(({ key, url, label, zhOnly }) => (
          <a
            href={url}
            hreflang={zhOnly ? "zh-CN" : undefined}
            aria-current={section === key ? "page" : undefined}
          >
            {label}
            {zhOnly && <small class="zh-only">{t.zhOnly}</small>}
          </a>
        ))}
        <a
          href={switchHref}
          hreflang={other === "en" ? "en" : "zh-CN"}
          lang={other === "en" ? "en" : "zh-CN"}
        >
          {t.switchLabel}
        </a>
        <a class="mobile-mail" href={`mailto:${profile.email}`}>
          {profile.email}
        </a>
      </nav>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <div class="footer-contact">
          <p>{t.footerPitch}</p>
          <a class="footer-mail" href={`mailto:${profile.email}`}>
            {profile.email}
          </a>
        </div>
        <div class="footer-links">
          <a href={profile.github}>GitHub ↗</a>
          <a href={profile.linkedin}>LinkedIn ↗</a>
          <a href="/feed.xml">RSS</a>
          <a href="/archive/" hreflang="zh-CN">
            {t.archive}
          </a>
        </div>
        <p class="endcard" aria-hidden="true">
          <span class="signature"></span>
        </p>
        <p class="footer-meta">
          <span>© 2026 Yuxuan Lin</span>
          <a href="#top" data-backtop>
            {t.backTop}
          </a>
        </p>
      </div>
    </footer>
    <script src="../scripts/site.js"></script>
  </body>
</html>
