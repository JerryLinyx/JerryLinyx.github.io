---
const { number, label, title, href, link = "继续探索" } = Astro.props;
---

<div class="section-head">
  <div>
    <p class="eyebrow">
      {number} / {label}
    </p>
    <h2>{title}</h2>
  </div>
  {href && (
    <a class="text-link" href={href}>
      {link}
      <span aria-hidden="true">↗</span>
    </a>
  )}
</div>
