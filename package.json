{
  "name": "my-web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "start": "node scripts/prepare-garden.mjs && ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-garden.mjs && ASTRO_TELEMETRY_DISABLED=1 astro build",
    "serve": "node scripts/serve.mjs",
    "deploy": "node scripts/publish-site.mjs",
    "verify:site": "node scripts/verify-site.mjs && node scripts/verify-curation.mjs",
    "sync:notes": "node scripts/sync-notes.mjs",
    "qa:browser": "node scripts/qa-site.cjs",
    "qa:a11y": "node scripts/qa-site.cjs --a11y",
    "format": "prettier --write src scripts astro.config.mjs",
    "inventory": "node scripts/inventory-assets.mjs"
  },
  "dependencies": {
    "astro": "^7.4.2",
    "gray-matter": "^4.0.3",
    "katex": "^0.16.47",
    "mermaid": "^12.2.0",
    "rehype-highlight": "^7.0.2",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "cheerio": "^1.2.0",
    "playwright": "^1.64.1",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=22.23.4"
  },
  "type": "module"
}
